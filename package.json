{
  "name": "antiphon",
  "version": "0.1.0",
  "description": "A local tabletop audio library, mixer, and live broadcast",
  "author": "Chaotic Wizard <contact@chaoticwizard.com> (https://chaoticwizard.com/)",
  "homepage": "https://chaoticwizard.com/",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder",
    "check": "npm run build && npm test",
    "test:desktop": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "local.antiphon",
    "productName": "Antiphon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    }
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
