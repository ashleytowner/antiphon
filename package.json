{
  "name": "antiphon",
  "desktopName": "antiphon.desktop",
  "version": "0.2.6",
  "description": "A local tabletop audio library, mixer, and live broadcast",
  "author": "Chaotic Wizard <contact@chaoticwizard.com> (https://chaoticwizard.com/)",
  "homepage": "https://chaoticwizard.com/",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "icons": "node scripts/icons.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never",
    "package:mac:x64": "npm run build && electron-builder --mac dmg --x64 --publish never",
    "package:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "check": "npm run build && npm test",
    "test:desktop": "npm run build && playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "local.antiphon",
    "productName": "Antiphon",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "syncDesktopName": true,
      "icon": "resources/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "asarUnpack": [
      "node_modules/@snazzah/davey-darwin-arm64/**/*.node",
      "node_modules/@snazzah/davey-darwin-x64/**/*.node"
    ]
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
